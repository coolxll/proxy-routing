#!name=Proxy Routing Rules
#!desc=自用代理分流规则模块（与 proxy-routing 仓库保持 100% 对齐，依赖 6 个核心策略组）
#!author=coolxll
#!category=Routing

[Rule]
# 局域网 / 私有地址直连
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/private.list,DIRECT,update-interval=86400

# 防误杀白名单（必须在广告拦截前）
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/unban.list,DIRECT,update-interval=86400

# 广告拦截
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanAD.list,REJECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanProgramAD.list,REJECT,update-interval=86400

# BT/P2P 下载防封直连
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/download.list,DIRECT,update-interval=86400

# Windows / Microsoft Update（WinHTTP / DO 默认直连）
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/windows-update.list,DIRECT,update-interval=86400

# 大流量（必须在 Google 前，避免 googlevideo.com 提前被 Google 匹配）
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/traffic-heavy.list,⬇️ 大流量,update-interval=86400

# Google 专属
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/google.list,Google,update-interval=86400

# AI 平台
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/ai.list,🤖 AI,update-interval=86400

# Microsoft / GitHub / Telegram / 通用代理全部归入 🚀 节点选择
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/microsoft.list,🚀 节点选择,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/github.list,🚀 节点选择,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/telegram.list,🚀 节点选择,update-interval=86400

# 银行 / 海外机酒 / Apple 核心与认证服务直连
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/bank.list,DIRECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/travel-direct.list,DIRECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/apple.list,DIRECT,update-interval=86400

# DMM / FANZA
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/dmm.list,🇯🇵 日本,update-interval=86400

# 额外直连
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/direct.list,DIRECT,update-interval=86400

# 额外代理
RULE-SET,https://raw.githubusercontent.com/coolxll/proxy-routing/main/rules/proxy.list,🚀 节点选择,update-interval=86400

# 中国域名与 IP 直连
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaDomain.list,DIRECT,update-interval=86400
GEOIP,CN,DIRECT
